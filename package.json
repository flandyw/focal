{
  "name": "focal",
  "private": true,
  "version": "1.7.3",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "bun run typecheck && vp build",
    "preview": "vp preview",
    "tauri": "tauri",
    "build:chatgpt-sidecar": "bun scripts/build-chatgpt-sidecar.ts",
    "lint": "vp lint src scripts server api server.ts vite.config.ts",
    "lint:fix": "vp lint src scripts server api server.ts vite.config.ts --fix",
    "test": "vp test",
    "check": "vp check && vp check --no-fmt --no-lint -- --tsconfig tsconfig.node.json",
    "typecheck": "vp check --no-fmt --no-lint && vp check --no-fmt --no-lint -- --tsconfig tsconfig.node.json",
    "dev:desktop": "vp dev --mode desktop",
    "build:desktop": "bun run typecheck && vp build --mode desktop",
    "start": "NODE_ENV=production bun server.ts",
    "mcp": "bun server/mcp/stdio.ts",
    "mcp:http": "bun server/mcp/http.ts",
    "vcaa:import": "bun vcaa/import-all-grade-distributions.mjs",
    "vcaa:resources": "bun vcaa/import-exam-resources.mjs",
    "vtac:import": "bun vtac/import-scaling-reports.mjs",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.86",
    "@ai-sdk/react": "4.0.133",

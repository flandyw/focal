    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "ai": "^7.0.130",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.0.0",
    "jose": "^6.2.12",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "next-themes": "^0.4.6",
    "proper-lockfile": "^4.1.2",

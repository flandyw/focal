VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Users save their own Gateway key in Settings > AI; encrypted in Supabase Vault.
AI_GATEWAY_MODEL=openai/gpt-6-luna
# Optional, server-side only: enables Artificial Analysis intelligence and speed sorting.
ARTIFICIAL_ANALYSIS_API_KEY=
# Desktop builds call the hosted backend. Web defaults to /api/chat.
VITE_CHAT_API_URL=
# The Tauri build starts this local sidecar automatically. Leave as is unless the
# local service runs elsewhere.
VITE_CHATGPT_BASE_PATH=http://localhost:41731/api/chatgpt

# Server-side only: Gateway chat reads saved Vault keys; MCP resolves access tokens.
# Never expose this service-role key to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Only for the stdio transport: an access token to act as its owner.
FOCAL_MCP_TOKEN=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The Tauri build starts this local sidecar automatically. Leave as is unless the
# local service runs elsewhere.
VITE_CHATGPT_BASE_PATH=http://localhost:41731/api/chatgpt

# MCP server (server/mcp, see docs/mcp.md). It signs in as one Focal account and acts as that user.
FOCAL_EMAIL=
FOCAL_PASSWORD=
# Bearer token clients must send to the HTTP endpoint. The endpoint is disabled while this is empty.
FOCAL_MCP_TOKEN=

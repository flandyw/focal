VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The Tauri build starts this local sidecar automatically. Leave as is unless the
# local service runs elsewhere.
VITE_CHATGPT_BASE_PATH=http://localhost:41731/api/chatgpt

# MCP server (server/mcp, see docs/mcp.md). Users create access tokens in Settings > MCP access.
# Server-side only (the VPS); never expose it to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Only for the stdio transport: an access token to act as its owner.
FOCAL_MCP_TOKEN=

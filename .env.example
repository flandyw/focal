VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Hosted Focal Web URL. Leave unset to use the default in src/lib/focal-web.ts.
# HTTPS only; Focal never puts account tokens or private data in it.
VITE_FOCAL_WEB_URL=https://focalvce.vercel.app/
# The Tauri build starts this local sidecar automatically. Set this to a deployed
# handler URL only when intentionally using the hosted-server mode.
VITE_CHATGPT_BASE_PATH=http://localhost:41731/api/chatgpt
